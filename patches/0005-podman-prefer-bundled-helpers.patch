+// preferBindir puts the directory of this podman in front of the helper,
+// conmon and OCI runtime paths, and points an absolute runtime at the bundled
+// copy of the same name. distrobox-in-appimage shim: an AppImage carries its
+// own crun, conmon and helpers, and a host crun older than this podman rejects
+// the OCI spec version it writes, so the bundled ones have to win over
+// /usr/bin. Called again after the config files are merged, so a containers.conf
+// cannot put the host's copies back in front.
+func preferBindir(e *EngineConfig) {
+	bindir := findBindir()
+	if bindir == "" {
+		return
+	}
+	if dirs := e.HelperBinariesDir.Get(); len(dirs) == 0 || dirs[0] != bindir {
+		e.HelperBinariesDir.Set(append([]string{bindir}, dirs...))
+	}
+	conmon := filepath.Join(bindir, "conmon")
+	if paths := e.ConmonPath.Get(); len(paths) == 0 || paths[0] != conmon {
+		e.ConmonPath.Set(append([]string{conmon}, paths...))
+	}
+	for name, paths := range e.OCIRuntimes {
+		bundled := filepath.Join(bindir, name)
+		if len(paths) == 0 || paths[0] != bundled {
+			e.OCIRuntimes[name] = append([]string{bundled}, paths...)
+		}
+	}
+	if filepath.IsAbs(e.OCIRuntime) {
+		bundled := filepath.Join(bindir, filepath.Base(e.OCIRuntime))
+		if _, err := os.Stat(bundled); err == nil {
+			e.OCIRuntime = bundled
+		}
+	}
+}
