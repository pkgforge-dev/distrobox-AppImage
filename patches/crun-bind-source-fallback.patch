+/* distrobox-in-appimage shim: distrobox binds its helper scripts from /usr/bin
+   inside the container, which exists on a normal install but not when
+   distrobox runs from an AppImage.  When CRUN_BIND_SOURCE_FALLBACK_DIR is set,
+   a missing bind source with one of the names below is looked up there
+   instead.  Opt-in and name-restricted on purpose: a missing bind source is
+   never silently replaced for anything else.  */
+static const char *
+get_bind_source_fallback (const char *path, char *buf, size_t bufsize)
+{
+  static const char *const allowed[] = {
+    "distrobox-init",
+    "distrobox-export",
+    "distrobox-host-exec",
+    NULL
+  };
+  const char *dir, *base;
+  size_t i;
+
+  dir = getenv ("CRUN_BIND_SOURCE_FALLBACK_DIR");
+  if (dir == NULL || dir[0] != '/')
+    return NULL;
+  if (path == NULL || path[0] != '/')
+    return NULL;
+
+  base = strrchr (path, '/');
+  if (base == NULL)
+    return NULL;
+  base++;
+
+  for (i = 0; allowed[i]; i++)
+    if (strcmp (base, allowed[i]) == 0)
+      break;
+  if (allowed[i] == NULL)
+    return NULL;
+
+  if (snprintf (buf, bufsize, "%s/%s", dir, base) >= (int) bufsize)
+    return NULL;
+
+  return buf;
+}
