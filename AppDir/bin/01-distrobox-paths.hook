#!/bin/sh

# the wrappers below live outside $APPDIR, which changes on every update:
# exported .desktop entries point at them

export DISTROBOX_BIN_DIR="$DATADIR"/distrobox-appimage

mkdir -p "$DISTROBOX_BIN_DIR"
cp -f "$APPDIR"/bin/distrobox-init "$APPDIR"/bin/distrobox-export \
	"$APPDIR"/bin/distrobox-host-exec "$DISTROBOX_BIN_DIR"

# catatonit runs as pid 1 inside the container, which cannot read the mount, so
# podman needs a real file outside it; the image ships the static binary in bin
cp -f "$APPDIR"/bin/catatonit "$DISTROBOX_BIN_DIR"/catatonit

# distrobox binds its container helpers from /usr/bin, which only exists for a
# distrobox installed on the host. Podman and crun (patches 0002 and 0003) both
# read this dir for those three names when /usr/bin has them missing: podman
# takes the mount options and crun mounts the copy at start. Real files outside
# the mount on purpose, since crun reads them from inside the container's
# namespace where the AppImage mount is not reachable
export CRUN_BIND_SOURCE_FALLBACK_DIR="$DISTROBOX_BIN_DIR"

# a copy of these cannot find podman from a desktop entry, launch the AppImage
for f in distrobox distrobox-enter; do
	printf '#!/bin/sh\nexec "${APPIMAGE:?}" "${0##*/}" "$@"\n' > "$DISTROBOX_BIN_DIR/$f"
	chmod +x "$DISTROBOX_BIN_DIR/$f"
done

# rootless podman joins the user and mount namespace saved by an earlier run
# (libpod/tmp/pause.pid) before any of its own code runs, so a namespace saved
# before this launch's mount existed leaves podman without conmon, crun or
# netavark. Drop it, unless containers still live in it
drop_saved_ns() {
	_run=${XDG_RUNTIME_DIR:-/nonexistent}
	_pid_file="$_run"/libpod/tmp/pause.pid

	# nothing has saved a namespace yet, which is the normal state until a
	# rootless podman runs for the first time. Checking for the file keeps the
	# shell from reporting the failed redirect on every launch
	[ -f "$_pid_file" ] || return 0

	# podman writes the pid with no trailing newline, so read returns non-zero
	# even when it read it: ignore the status and check the value instead
	_pid=
	read -r _pid < "$_pid_file" || :
	[ -n "$_pid" ] || return 0

	# a recycled pid must never be killed: the pause process is the one with
	# _PODMAN_PAUSE=1 in its environ
	[ -r /proc/"$_pid"/environ ] || return 0
	tr '\0' '\n' < /proc/"$_pid"/environ | grep -qx '_PODMAN_PAUSE=1' || return 0

	# that namespace already has this launch's mount
	[ ! -e /proc/"$_pid"/root"$APPDIR"/AppRun ] || return 0

	for _p in /proc/[0-9]*; do
		_p=${_p#/proc/}
		if [ "$_p" = "$_pid" ] || [ ! /proc/"$_p"/ns/mnt -ef /proc/"$_pid"/ns/mnt ]; then
			continue
		fi
		>&2 echo "podman is using a saved namespace without this AppImage mount, and pid $_p still runs in it"
		>&2 echo "Stop it with the podman that started it, then run this again"
		exit 1
	done

	kill "$_pid" 2>/dev/null
	rm -f "$_run"/libpod/tmp/pause.pid "$_run"/libpod/tmp/ns_handles
}

drop_saved_ns
