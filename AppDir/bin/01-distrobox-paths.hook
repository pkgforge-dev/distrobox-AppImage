#!/bin/sh

# the wrappers and containers.conf below live outside $APPDIR, which changes on
# every update: exported .desktop entries point at them

export DISTROBOX_BIN_DIR="$DATADIR"/distrobox-appimage

# distrobox binds its container helpers from /usr/bin, which only exists for a
# distrobox installed on the host. crun is patched to look here instead, and
# only for those three names
export CRUN_BIND_SOURCE_FALLBACK_DIR="$APPDIR"/bin

mkdir -p "$DISTROBOX_BIN_DIR"

# a copy of these cannot find podman from a desktop entry, launch the AppImage
for f in distrobox distrobox-enter; do
	printf '#!/bin/sh\nexec "${APPIMAGE:?}" "${0##*/}" "$@"\n' > "$DISTROBOX_BIN_DIR/$f"
	chmod +x "$DISTROBOX_BIN_DIR/$f"
done

# podman must read its config from outside the mount too: $APPDIR changes on
# every update, and a config path that is not there stops every podman call
if [ -f "$APPDIR"/etc/containers/containers.conf ]; then
	cp -f "$APPDIR"/etc/containers/containers.conf "$DISTROBOX_BIN_DIR"/containers.conf
	export CONTAINERS_CONF_OVERRIDE="$DISTROBOX_BIN_DIR"/containers.conf
fi

# rootless podman joins the user and mount namespace saved by an earlier run
# (libpod/tmp/pause.pid) before any of its own code runs, so a namespace saved
# before this launch's mount existed leaves podman without conmon, crun or
# netavark. Drop it, unless containers still live in it
drop_saved_ns() {
	_run=${XDG_RUNTIME_DIR:-/nonexistent}

	if ! _pid=$(cat "$_run"/libpod/tmp/pause.pid 2>/dev/null); then
		return 0
	fi

	# a recycled pid must never be killed: the pause process is the one with
	# _PODMAN_PAUSE=1 in its environ
	if ! tr '\0' '\n' < /proc/"$_pid"/environ 2>/dev/null | grep -qx '_PODMAN_PAUSE=1'; then
		return 0
	fi

	# that namespace already has this launch's mount
	if [ -e /proc/"$_pid"/root"$APPDIR"/AppRun ]; then
		return 0
	fi

	for _p in /proc/[0-9]*; do
		_p=${_p#/proc/}
		if [ "$_p" = "$_pid" ] || [ ! /proc/"$_p"/ns/mnt -ef /proc/"$_pid"/ns/mnt ]; then
			continue
		fi
		>&2 echo "podman is using a saved namespace without this AppImage mount, and pid $_p still runs in it"
		>&2 echo "Stop it with the podman that started it, then run this again"
		exit 1
	done

	kill "$_pid" 2>/dev/null
	rm -f "$_run"/libpod/tmp/pause.pid "$_run"/libpod/tmp/ns_handles
}

drop_saved_ns
