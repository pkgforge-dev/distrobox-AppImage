#!/bin/sh

# for some reason this fails to work when FUSE or unshare is in use: 
# Error: default OCI runtime "crun" not found: invalid argument
# so we will have to copy the binaries outside FUSE before running them

WORKAROUND_PATH="${XDG_CACHE_HOME:-$HOME/.cache}"/distrobox-appimage

mkdir -p "$WORKAROUND_PATH"
cp -r "$APPDIR"/bin    "$WORKAROUND_PATH"
cp "$APPDIR"/sharun    "$WORKAROUND_PATH"
cp "$APPDIR"/.env      "$WORKAROUND_PATH" 2>/dev/null || :
cp "$APPDIR"/.preload  "$WORKAROUND_PATH" 2>/dev/null || :

ln -sfn "$APPDIR"/lib     "$WORKAROUND_PATH"/lib
ln -sfn "$APPDIR"/share   "$WORKAROUND_PATH"/share
ln -sfn "$APPDIR"/shared  "$WORKAROUND_PATH"/shared
ln -sfn "$APPDIR"/etc     "$WORKAROUND_PATH"/etc 2>/dev/null || :

# override APPDIR now so that the AppRun launches the right binaries
APPDIR="$WORKAROUND_PATH"
